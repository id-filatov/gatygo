#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Stop and delete"
msgstr "Остановить и удалить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Delete"
msgstr "Удалить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Cancel"
msgstr "Отмена"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Deleting…"
msgstr "Удаление…"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "An update is running. Try again in a minute."
msgstr "Идёт обновление. Попробуйте через минуту."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "The subscription could not be deleted."
msgstr "Не удалось удалить подписку."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Delete the subscription?"
msgstr "Удалить подписку?"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "The VPN stops and your devices go online directly, without the VPN."
msgstr "VPN остановится, и устройства выйдут в интернет напрямую, без VPN."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Your provider still counts this router as a device: remove it in your account if you need the slot back."
msgstr "Провайдер по-прежнему считает этот роутер устройством: удалите его в личном кабинете, если нужно освободить место."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "The router did not answer: %s"
msgstr "Роутер не ответил: %s"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "tunnel"
msgstr "туннель"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "direct"
msgstr "напрямую"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "blocked"
msgstr "заблокирован"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "✓ The rule works"
msgstr "✓ Правило работает"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "— The rule changes nothing"
msgstr "— Правило ничего не меняет"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "✗ The rule does not work: the VPN provider sends it direct"
msgstr "✗ Правило не работает: VPN-провайдер отправляет напрямую"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "✗ The rule does not work: the VPN provider sends it through the tunnel"
msgstr "✗ Правило не работает: VPN-провайдер отправляет в туннель"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "✗ The rule does not work: the VPN provider blocks it"
msgstr "✗ Правило не работает: VPN-провайдер блокирует"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "✗ The rule does not work: IPv6 is off in the gatygo settings"
msgstr "✗ Правило не работает: IPv6 отключён в настройках gatygo"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "✗ The rule does not work: IPv6 goes around the VPN"
msgstr "✗ Правило не работает: IPv6 идёт мимо VPN"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "✗ The rule does not work: the local network always goes direct"
msgstr "✗ Правило не работает: локальная сеть всегда идёт напрямую"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Could not check"
msgstr "Не удалось проверить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "The check works while the VPN is on"
msgstr "Проверка работает, когда VPN включён"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "VPN provider rules take priority. A domain covers its subdomains."
msgstr "Правила VPN-провайдера в приоритете. Домен действует вместе с поддоменами."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "An address works where no site name is seen: Telegram, calls, games. For sites, add the domain."
msgstr "Адрес действует там, где не видно имени сайта: Telegram, звонки, игры. Для сайтов вписывайте домен."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Addresses"
msgstr "Адреса"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Domains"
msgstr "Домены"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Domain or address"
msgstr "Домен или адрес"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Route"
msgstr "Куда"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Now, in %s"
msgstr "Сейчас, в %s"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "domain or address"
msgstr "домен или адрес"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "A domain or an address is needed, for example example.com or 203.0.113.0/24"
msgstr "Нужен домен или адрес, например example.com или 203.0.113.0/24"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "This address is already listed"
msgstr "Этот адрес уже есть"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "This domain is already listed"
msgstr "Этот домен уже есть"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Add"
msgstr "Добавить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "%s → IPv6 is off in the gatygo settings"
msgstr "%s → IPv6 отключён в настройках gatygo"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "%s → IPv6 goes around the VPN"
msgstr "%s → IPv6 идёт мимо VPN"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "%s → direct (local network)"
msgstr "%s → напрямую (локальная сеть)"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Check"
msgstr "Проверить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Where will a site go?"
msgstr "Куда пойдёт сайт?"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "The log is empty."
msgstr "Журнал пуст."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Changes take effect after Save & Apply: the subscription is downloaded again with the new settings."
msgstr "Изменения вступают в силу после «Сохранить и применить»: подписка загружается заново с новыми настройками."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Enable"
msgstr "Включить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Start the tunnel at boot and keep it running."
msgstr "Запускать туннель при загрузке роутера и держать его включённым."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Subscription URL"
msgstr "Ссылка на подписку"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Stored on the router only. The log never shows it."
msgstr "Хранится только на роутере. В журнал не попадает."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Expecting an http:// or https:// URL"
msgstr "Нужна ссылка вида http:// или https://"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Subscription URL, masked"
msgstr "Ссылка на подписку, скрытая"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Change"
msgstr "Изменить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "User agent"
msgstr "User agent"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Your provider's server picks the format of the list by this name, and gatygo needs Xray JSON. If the default is not recognised, choose the app your provider supports."
msgstr "По этому имени сервер провайдера выбирает формат списка, а gatygo нужен Xray JSON. Если вариант по умолчанию не распознаётся, выберите приложение, которое поддерживает ваш провайдер."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "default"
msgstr "по умолчанию"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Send device ID"
msgstr "Отправлять ID устройства"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Sent as the x-hwid header. Panels with a device limit count this router as one device."
msgstr "Передаётся в заголовке x-hwid. Панели с лимитом устройств считают этот роутер одним устройством."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Device ID"
msgstr "ID устройства"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "generated on the first update"
msgstr "создаётся при первом обновлении"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Update every"
msgstr "Обновлять"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "How often the list of countries is downloaded again."
msgstr "Как часто заново загружать список стран."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "As the subscription suggests"
msgstr "Как предлагает подписка"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "As the subscription suggests (%d h)"
msgstr "Как предлагает подписка (%d ч)"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Every hour"
msgstr "Каждый час"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Every %d hours"
msgstr "Каждые %d ч"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Block LAN IPv6"
msgstr "Блокировать IPv6 в LAN"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "IPv6 is not proxied. Blocking it keeps devices with IPv6 addresses from bypassing the tunnel."
msgstr "IPv6 не проксируется. Блокировка не даёт устройствам с IPv6-адресами обходить туннель."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "If the VPN stops by itself"
msgstr "Если VPN остановится сам"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "It is rare, but xray can quit, for example when the router runs out of memory. Blocking keeps everything inside the VPN at the price of no internet at home until someone presses Start. Either way the main page says what happened and when."
msgstr "Это редкость, но xray может завершиться, например когда у роутера кончается память. Блокировка держит всё внутри VPN ценой отсутствия интернета дома, пока кто-нибудь не нажмёт «Запустить». В любом случае главная страница покажет, что и когда произошло."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Block the internet until the VPN is back"
msgstr "Без интернета, пока VPN не вернётся"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Let devices use the regular internet"
msgstr "Пускать устройства в обычный интернет"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Connections per device"
msgstr "Соединений на устройство"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "At most this many connections of one device go through the VPN at a time; new ones over it are refused. A busy device, a torrent client say, cannot take the memory xray needs for the whole home."
msgstr "Сколько соединений одного устройства может одновременно идти через VPN; новые сверх этого числа отклоняются. Так занятое устройство, например торрент-клиент, не заберёт память, которая нужна xray для всего дома."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Connections in all"
msgstr "Соединений всего"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "At most this many connections of all devices together. Each one costs xray 50–70 KB of memory: 1000 suits a router with 256 MB."
msgstr "Сколько соединений всех устройств вместе может быть одновременно. Каждое стоит xray 50–70 КБ памяти: 1000 подходит роутеру с 256 МБ."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Resolver for server names"
msgstr "DNS для имён серверов"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Used only to resolve the VPN servers' own host names, outside the tunnel. Empty: the WAN DNS."
msgstr "Нужен только чтобы находить адреса самих VPN-серверов по их именам, вне туннеля. Пусто: DNS от WAN."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "WAN DNS"
msgstr "DNS от WAN"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Log level"
msgstr "Уровень журнала"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Loading…"
msgstr "Загрузка…"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Log"
msgstr "Журнал"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Refresh"
msgstr "Обновить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Last 200 xray and gatygo lines of the system log"
msgstr "Последние 200 строк xray и gatygo из системного журнала"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Settings"
msgstr "Настройки"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Your account cannot read the gatygo settings."
msgstr "У вашей учётной записи нет доступа к настройкам gatygo."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "My rules"
msgstr "Мои правила"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Update"
msgstr "Обновить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Back to gatygo"
msgstr "Назад к gatygo"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/advanced.js
msgid "Advanced"
msgstr "Дополнительно"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%d d %d h"
msgstr "%d д %d ч"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%d h %d min"
msgstr "%d ч %d мин"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%d min"
msgstr "%d мин"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "just now"
msgstr "только что"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "%d минуту назад"
msgstr[1] "%d минуты назад"
msgstr[2] "%d минут назад"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "%d час назад"
msgstr[1] "%d часа назад"
msgstr[2] "%d часов назад"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "%d день назад"
msgstr[1] "%d дня назад"
msgstr[2] "%d дней назад"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "An update is already running."
msgstr "Обновление уже идёт."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "This does not look like a link. It starts with https://"
msgstr "Это не похоже на ссылку. Она начинается с https://"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "You stay connected with the previous settings."
msgstr "Подключение остаётся с прежними настройками."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Try again"
msgstr "Повторить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Stopped by itself"
msgstr "Остановился сам"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The VPN stopped by itself %s"
msgstr "VPN остановился сам %s"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The VPN stopped by itself"
msgstr "VPN остановился сам"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Devices at home use the regular internet since then: what needs the VPN does not open. Press Start to try again."
msgstr "С тех пор устройства дома ходят в обычный интернет: то, что требует VPN, не открывается. Нажмите «Запустить», чтобы попробовать снова."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Devices at home have no internet now. Press Start to try again, or turn the VPN off to use the regular internet."
msgstr "Сейчас у устройств дома нет интернета. Нажмите «Запустить», чтобы попробовать снова, или выключите VPN, чтобы пользоваться обычным интернетом."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "xray was killed (exit code 137), most often because the router ran out of memory"
msgstr "xray был принудительно завершён (код 137), чаще всего потому, что у роутера кончилась память"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "xray exit code %d"
msgstr "код завершения xray %d"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Turn off"
msgstr "Выключить"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Subscription expired"
msgstr "Подписка истекла"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Your subscription ended on %s"
msgstr "Подписка закончилась %s"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The VPN servers no longer accept this router, so sites may not open. Renew the subscription with your provider, then press Update now."
msgstr "VPN-серверы больше не принимают этот роутер, поэтому сайты могут не открываться. Продлите подписку у провайдера, затем нажмите «Обновить сейчас»."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Traffic used up"
msgstr "Трафик исчерпан"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "You have used all %s of this period"
msgstr "Израсходованы все %s за этот период"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The VPN servers stop serving this router until your provider resets the counter or you buy more traffic. After that press Update now."
msgstr "VPN-серверы не обслуживают этот роутер, пока провайдер не сбросит счётчик или вы не докупите трафик. После этого нажмите «Обновить сейчас»."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Couldn’t update the list of countries"
msgstr "Не удалось обновить список стран"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Your provider’s server did not answer %s."
msgstr "Сервер провайдера не ответил %s."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "gatygo tries again in %s."
msgstr "gatygo попробует снова через %s."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Too many devices on this subscription"
msgstr "Слишком много устройств на этой подписке"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Your provider limits the number of devices and the limit is reached. Remove a device in your provider’s account, then try again."
msgstr "Провайдер ограничивает число устройств, и лимит исчерпан. Удалите устройство в личном кабинете провайдера, затем попробуйте снова."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Your provider’s server did not recognise this router"
msgstr "Сервер провайдера не распознал этот роутер"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "It answered, but not with a list of countries. Ask your provider whether routers are supported, or change User agent in Settings."
msgstr "Он ответил, но не списком стран. Спросите провайдера, поддерживаются ли роутеры, или смените User agent в настройках."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Open settings"
msgstr "Открыть настройки"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The new settings from your provider did not pass the check"
msgstr "Новые настройки от провайдера не прошли проверку"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "gatygo tests every update before using it, and this one failed."
msgstr "gatygo проверяет каждое обновление перед применением, и это обновление проверку не прошло."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%s is no longer in your subscription"
msgstr "%s больше нет в вашей подписке"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "gatygo uses %s instead. Tap another country if you prefer."
msgstr "Вместо этого gatygo использует %s. Если хотите, выберите другую страну."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "OK"
msgstr "ОК"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Couldn’t switch to %s"
msgstr "Не удалось переключиться на %s"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The country in use is still %s."
msgstr "По-прежнему используется %s."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Couldn’t download the VPN engine"
msgstr "Не удалось загрузить движок VPN"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "gatygo downloads it from GitHub once after it is installed or updated. Check the router’s internet connection, then try again."
msgstr "gatygo загружает его с GitHub один раз после установки или обновления. Проверьте подключение роутера к интернету, затем попробуйте снова."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "There is no list of countries yet"
msgstr "Списка стран пока нет"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Press Try again to download it."
msgstr "Нажмите «Повторить», чтобы загрузить его."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The last update failed"
msgstr "Последнее обновление не удалось"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The last update finished with a warning"
msgstr "Последнее обновление завершилось с предупреждением"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Another action is running: a subscription update or a country switch. Try again in a minute."
msgstr "Идёт другое действие: обновление подписки или смена страны. Попробуйте через минуту."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "GitHub did not give the new version."
msgstr "GitHub не отдал новую версию."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "GitHub did not answer. Check the router's internet connection and try again."
msgstr "GitHub не ответил. Проверьте интернет на роутере и попробуйте ещё раз."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The current version is not on GitHub: there would be nothing to go back to."
msgstr "Текущей версии нет на GitHub: вернуться было бы не на что."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "gatygo needs OpenWrt 25.12, the router runs %s."
msgstr "Нужна OpenWrt 25.12, на роутере %s."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%s is installed: it owns the same proxy rules. Remove it first."
msgstr "Установлен %s: он управляет теми же правилами. Сначала удалите его."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The new version has no xray core for this router's processor."
msgstr "В новой версии нет ядра xray для процессора этого роутера."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Not enough flash: %d MB needed, %d MB free."
msgstr "Мало места на флешке: нужно %d МБ, свободно %d МБ."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Not enough memory: %d MB needed, %d MB free."
msgstr "Мало оперативной памяти: нужно %d МБ, свободно %d МБ."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The packages could not be downloaded."
msgstr "Не удалось скачать пакеты."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "A downloaded file is damaged: its checksum does not match."
msgstr "Скачанный файл повреждён: контрольная сумма не совпала."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The router's package feeds do not have: %s."
msgstr "В источниках пакетов роутера нет: %s."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The router's package feeds do not have everything the new version needs."
msgstr "В источниках пакетов роутера нет всего, что нужно новой версии."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The packages did not install."
msgstr "Пакеты не установились."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The xray core did not install."
msgstr "Ядро xray не установилось."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The new version could not build the settings from the subscription."
msgstr "Новая версия не собрала настройки из подписки."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The new version did not start."
msgstr "Новая версия не запустилась."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The previous version could not be put back. Reinstall gatygo with install.sh."
msgstr "Не удалось вернуть прежнюю версию. Переустановите gatygo через install.sh."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The update stopped halfway. If the VPN does not work, reinstall gatygo with install.sh."
msgstr "Обновление прервалось на полпути. Если VPN не работает, переустановите gatygo через install.sh."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Checking the router"
msgstr "Проверка роутера"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Downloading"
msgstr "Скачивание"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Installing"
msgstr "Установка"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "xray core"
msgstr "Ядро xray"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Restarting the VPN and checking"
msgstr "Перезапуск VPN и проверка"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Update to %s?"
msgstr "Обновить до %s?"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "The internet through the VPN drops for a few seconds. The subscription, country, settings and My rules stay."
msgstr "Интернет через VPN пропадёт на несколько секунд. Подписка, страна, настройки и «Мои правила» сохранятся."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Version %s is running."
msgstr "Работает %s."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Update failed"
msgstr "Обновить не удалось"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Close"
msgstr "Закрыть"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Updated to %s"
msgstr "Обновлено до %s"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "not downloaded, the current one works; retried with the next subscription update"
msgstr "не скачалось, работает прежнее; повторит при обновлении подписки"

