msgstr "gatygo не смог настроить подключение."

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Not set up yet"
msgstr "Ещё не настроено"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
