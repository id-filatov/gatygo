msgid "%d ms"
msgstr "%d мс"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "%s s"
msgstr "%s с"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
msgid "Checked through the VPN"
msgstr "Проверено через VPN"

#: luci-app-gatygo/htdocs/luci-static/resources/view/gatygo/main.js
