#!/bin/sh
# gatygo command line. The service itself is /etc/init.d/gatygo (procd).
#   gatygo start|stop|restart        service control
#   gatygo forget                    drop the subscription: stop, erase what it brought, default settings
#   gatygo update                    run the subscription update cycle now
#   gatygo select <profile>          switch to a subscription tile (remarks) and apply it
#   gatygo apply [wait]              rebuild the config from the cached subscription (Save & Apply)
#   gatygo check [fresh]             JSON: do the usual services open through the tunnel
#   gatygo ping [kept]               JSON: the response time of every country
#   gatygo route <domain>            JSON: where the domain goes now (tunnel, direct, blocked)
#   gatygo rules                     JSON: the user's rules and what each does in the current country
#   gatygo status                    JSON for scripts and the LuCI page
#   gatygo nodes                     JSON: outbounds with balancer selection and traffic
#   gatygo log [N]                   last N xray/gatygo lines of the system log (default 200)
#   gatygo updating                  exit 0 while an update runs
#   gatygo cron-sync                 re-create the periodic update line
#   gatygo watch                     wait for xray to quit for good (run by the service itself)
#   gatygo upgrade due|check         exit 0 when the daily look at the latest release is due | look now
#   gatygo upgrade running|run|dismiss  exit 0 while an upgrade runs | upgrade now | drop its outcome
#   gatygo upgrade start             JSON: launch an upgrade in the background (the page's Update)
#   gatygo version
GATYGO_LIB=${GATYGO_LIB:-/usr/lib/gatygo}
. "$GATYGO_LIB/config.sh"

usage() {
	echo "usage: gatygo start|stop|restart|connect <url>|forget|update|select <profile>|apply [wait]|check [fresh]|ping [kept]|route <domain>|rules|status|nodes|log [N]|updating|cron-sync|watch|upgrade due|check|start|running|run|dismiss|version" >&2
	exit 1
}

# The first run from the page: store the link, enable the service, start it. `start` downloads
# the subscription when there is no config yet. Done here and not through a UCI apply: the
# init script's reload trigger only exists while procd knows the service (not after a stop).
cmd_connect() {
	case $1 in http://?* | https://?*) ;; *) usage ;; esac
	_init=${GATYGO_INIT:-/etc/init.d/gatygo}
	uci set gatygo.main.sub_url="$1" && uci set gatygo.main.enabled=1 && uci commit gatygo || return 1
	"$_init" enable
	"$_init" start
}

# Drop the subscription (lib/forget.sh): the VPN stops, everything the subscription brought is
# erased, the settings return to their defaults. Exit 2: an update is running, try again later.
cmd_forget() {
	. "$GATYGO_LIB/service.sh"
	. "$GATYGO_LIB/forget.sh"
	gatygo_load_config
	gatygo_forget
	case $? in
	0) return 0 ;;
	2) echo "an update is running; try again when it finishes" >&2; return 2 ;;
	3) echo "the settings could not be written" >&2; return 1 ;;
	4) echo "refusing to erase: the state paths are not absolute" >&2; return 1 ;;
	*) echo "the VPN could not be stopped" >&2; return 1 ;;
	esac
}

# Do the listed services open through the tunnel? Prints {available, tunnel, time, services:
# [{name, ms|null}]}. A result younger than 5 minutes for the same tunnel (profile and xray
# process) is reused unless `fresh` is given. available=false: xray is not running, or its config predates the check
# inbound (the next update rebuilds it).
cmd_check() {
	. "$GATYGO_LIB/check.sh"
	. "$GATYGO_LIB/service.sh"
	gatygo_load_config
	if ! gatygo_xray_running || ! jq -e --argjson p "$GATYGO_CHECK_PORT" \
		'.inbounds[] | select(.tag == "check" and .port == $p)' "$GATYGO_STATE/xray.json" >/dev/null 2>&1; then
		echo '{"available":false}'
		return 0
	fi
	_tunnel="$(cat "$GATYGO_STATE/profile" 2>/dev/null):$(gatygo_xray_pid)"
	if [ "$1" != fresh ] && gatygo_check_cached "$_tunnel" 300; then return 0; fi
	# the password as the config in use has it (none in a config from before there was one)
	_auth=$(jq -r '.inbounds[] | select(.tag == "check") | .settings.accounts[0] // empty | "\(.user):\(.pass)"' \
		"$GATYGO_STATE/xray.json" 2>/dev/null)
	gatygo_check_store "$_tunnel" "$(gatygo_check_run "$GATYGO_CHECK_PORT" "$_auth")"
}

# The response time of every country: prints {time, measuring, profiles: [{remarks, ms|null}]}.
# `ping` measures now (10-20 s on a large subscription, one run at a time); `ping kept` prints
# the last result and exits 1 when a run is due (none yet, or older than 5 minutes).
cmd_ping() {
	. "$GATYGO_LIB/ping.sh"
	if [ "$1" = kept ]; then gatygo_ping_kept 300; return; fi
	if [ ! -s "$GATYGO_STATE/subscription.json" ] || ! gatygo_lock ping; then
		gatygo_ping_kept 300
		return 0
	fi
	trap 'gatygo_unlock ping' EXIT
	# a result for another subscription (updated or replaced meanwhile) is not kept
	_sum=$(sha256sum < "$GATYGO_STATE/subscription.json")
	gatygo_ping_store "$(gatygo_ping_run "$GATYGO_STATE/subscription.json")" "$_sum"
}

# Where DOMAIN goes now: {available, to: proxy|direct|block|null}. available=false: xray is not
# running; to=null: xray did not answer (or its config has no API). Not a domain: {error}, exit 1.
cmd_route() {
	. "$GATYGO_LIB/service.sh"
	. "$GATYGO_LIB/rules.sh"
	. "$GATYGO_LIB/route.sh"
	gatygo_load_config
	gatygo_rule_domain_ok "$1" || {
		echo '{"error":"not a domain"}'
		return 1
	}
	gatygo_xray_running || {
		echo '{"available":false,"to":null}'
		return 0
	}
	_to=''
	if jq -e '.inbounds[]? | select(.tag == "api")' "$GATYGO_STATE/xray.json" >/dev/null 2>&1; then
		_to=$(gatygo_route_where "$GATYGO_STATE/xray.json" "$1") || _to=''
	fi
	jq -nc --arg to "$_to" '{available: true, to: (if $to == "" then null else $to end)}'
}

# The user's rules as saved and what each does in the country in use: {available, api, pending,
# profile, rules: [{domain, to, status}]} (statuses: lib/route.sh). No statuses (null) while xray
# is not running (available) or its API does not answer or is not in its config (api), and while the installed config
# does not carry the saved rules yet (pending: an update or Save & Apply is on its way).
cmd_rules() {
	. "$GATYGO_LIB/service.sh"
	. "$GATYGO_LIB/rules.sh"
	. "$GATYGO_LIB/route.sh"
	gatygo_load_config
	_rules=$(gatygo_rules_json quiet)
	_available=false _api=false _pending=false
	if gatygo_xray_running; then
		_available=true
		gatygo_route_api "$GATYGO_STATE/xray.json" && _api=true
		# a dead API (curl without HTTP/2, say) leaves the page without statuses: one line in the
		# log says why, not one per visit
		if [ "$_api" = true ]; then
			rm -f "$GATYGO_RUN/route-api-down"
		elif [ ! -e "$GATYGO_RUN/route-api-down" ]; then
			mkdir -p "$GATYGO_RUN" && : > "$GATYGO_RUN/route-api-down"
			gatygo_log warn "the xray API does not answer: no rule statuses, no site check"
		fi
	fi
	_applied=$(cat "$GATYGO_STATE/rules.json" 2>/dev/null)
	if gatygo_updating || [ "${_applied:-[]}" != "$_rules" ]; then _pending=true; fi
	if [ "$_available$_api$_pending" = truetruefalse ]; then
		_status=$(gatygo_rules_status "$GATYGO_STATE/xray.json" "$_rules")
	else
		_status=$(printf '%s' "$_rules" | jq -c 'map(. + {status: null})')
	fi
	jq -nc --argjson available "$_available" --argjson api "$_api" --argjson pending "$_pending" \
		--arg profile "$(cat "$GATYGO_STATE/profile" 2>/dev/null)" --argjson rules "$_status" \
		'{available: $available, api: $api, pending: $pending, profile: $profile, rules: $rules}'
}

cmd_update() {
	. "$GATYGO_LIB/update.sh"
	. "$GATYGO_LIB/service.sh"
	. "$GATYGO_LIB/dns.sh"
	gatygo_load_config
	gatygo_update_lock || {
		# the upgrade of gatygo holds it while the packages install: it runs the update after
		if gatygo_locked upgrade; then
			touch "$GATYGO_RUN/update-wanted"
			gatygo_log info "update: after the gatygo upgrade"
		else
			gatygo_log info "update skipped: another update is running"
		fi
		return 0
	}
	trap gatygo_update_unlock EXIT
	# without xray the router's own DNS must not point at xray (design decision 2)
	gatygo_xray_running || gatygo_dns_restore
	gatygo_update
	_rc=$?
	if gatygo_xray_running; then
		gatygo_load_config
		gatygo_dns_apply "$GATYGO_STATE/xray.json"
		gatygo_cron_sync "$(gatygo_update_interval_hours)"
	fi
	return $_rc
}

# Switch the profile. Waits its turn behind an update or `gatygo forget` (the update lock, exit 2):
# either could otherwise see its files change under it. Without a link (deleted, or a page from
# before the delete) nothing is written, not even a result.
cmd_select() {
	[ -n "$1" ] || usage
	. "$GATYGO_LIB/update.sh"
	. "$GATYGO_LIB/service.sh"
	. "$GATYGO_LIB/dns.sh"
	gatygo_load_config
	[ -n "$GATYGO_SUB_URL" ] || {
		echo "no subscription; connect one first" >&2
		return 1
	}
	gatygo_update_lock || {
		echo "an update is running; try again when it finishes" >&2
		return 2
	}
	trap gatygo_update_unlock EXIT
	uci set gatygo.main.profile="$1" && uci commit gatygo
	gatygo_load_config
	[ -s "$GATYGO_STATE/subscription.json" ] || {
		gatygo_select_result error no_cache "no cached subscription; run 'gatygo update' first"
		return 1
	}
	_stage=$(mktemp -d)
	_prof=$(gatygo_apply_profile "$GATYGO_STATE/subscription.json" "$_stage")
	_rc=$?
	rm -rf "$_stage"
	_changed=0
	[ "$(cat "$GATYGO_RUN/swap-result" 2>/dev/null)" = changed ] && _changed=1
	case $_rc in
	1)
		gatygo_select_result error apply_failed "profile '$1' could not be applied; keeping the current config"
		return 1
		;;
	3) gatygo_select_result warning profile_missing "profile '$1' is not in the subscription; using '$_prof'" "$_prof" "$_changed" ;;
	*) gatygo_select_result ok applied "profile applied" "$_prof" "$_changed" ;;
	esac
	if [ "$_changed" = 1 ] && gatygo_xray_running; then
		gatygo_dns_apply "$GATYGO_STATE/xray.json"
		_gatygo_reload
	fi
	printf '%s\n' "$_prof"
}

# Rebuild xray.json from the cached subscription with the settings and the user's rules as they
# are now: Save & Apply (the init script's reload) runs this before the download, so the rules
# work even when the panel does not answer. Writes no result: the last update's stays. Exit 2:
# an update holds the lock (`wait`: still after 60 s); 1: no cached subscription, or the config
# failed the test (the current one stays).
cmd_apply() {
	. "$GATYGO_LIB/update.sh"
	. "$GATYGO_LIB/service.sh"
	. "$GATYGO_LIB/dns.sh"
	gatygo_load_config
	[ -n "$GATYGO_SUB_URL" ] || return 0
	# an upgrade of gatygo rebuilds the config itself, with the new code and the settings as they
	# are then; a rebuild started before it would mix the old code with the new files
	_upgrade_rebuilds() {
		gatygo_locked upgrade && [ "${GATYGO_UPGRADE_RUN:-}" != 1 ] || return 1
		gatygo_log info "apply: the gatygo upgrade rebuilds the config"
	}
	_upgrade_rebuilds && return 0
	_i=0
	until gatygo_update_lock; do
		[ "$1" = wait ] && [ "$_i" -lt 60 ] || return 2
		_i=$((_i + 1))
		sleep 1
	done
	trap gatygo_update_unlock EXIT
	_upgrade_rebuilds && return 0
	_stage=$(mktemp -d)
	gatygo_apply_profile "$GATYGO_STATE/subscription.json" "$_stage" >/dev/null
	_rc=$?
	rm -rf "$_stage"
	if [ "$_rc" = 1 ] || [ ! -s "$GATYGO_STATE/subscription.json" ]; then
		gatygo_log error "settings could not be applied to the cached subscription; keeping the current config"
		return 1
	fi
	if [ "$(cat "$GATYGO_RUN/swap-result" 2>/dev/null)" = changed ] && gatygo_xray_running; then
		gatygo_dns_apply "$GATYGO_STATE/xray.json"
		_gatygo_reload
	fi
}

cmd_status() {
	. "$GATYGO_LIB/service.sh"
	. "$GATYGO_LIB/subscription.sh"
	. "$GATYGO_LIB/upgrade.sh"
	gatygo_load_config
	_running=false _updating=false _configured=false _enabled=false _send_hwid=false _uptime='' _next=''
	gatygo_xray_running && _running=true
	gatygo_updating && _updating=true
	[ -n "$GATYGO_SUB_URL" ] && _configured=true
	[ "$GATYGO_ENABLED" = 1 ] && _enabled=true
	[ "$GATYGO_SEND_HWID" = 1 ] && _send_hwid=true
	_pid=$(gatygo_xray_pid)
	[ -n "$_pid" ] && _uptime=$(gatygo_proc_uptime "$_pid")
	_crashed='' _crash=null
	[ "$_running" = true ] || _crashed=$(gatygo_xray_crashed)
	# what the watcher noted when procd gave up on xray (lib/crash.sh)
	if [ -n "$_crashed" ] && [ -s "$GATYGO_RUN/crash.env" ]; then
		_crash=$(jq -nc --arg time "$(_gatygo_env_get "$GATYGO_RUN/crash.env" TIME)" \
			--arg direct "$(_gatygo_env_get "$GATYGO_RUN/crash.env" DIRECT)" --rawfile log "$GATYGO_RUN/crash.log" \
			'{time: ($time | tonumber), direct: ($direct == "1"), log: ($log | rtrimstr("\n"))}' 2>/dev/null) || _crash=null
	fi
	# what the last switch of the profile ended with, if no update came after it
	_select=null
	if [ -s "$GATYGO_RUN/last-select.env" ]; then
		_select=$(jq -nc --arg result "$(_gatygo_env_get "$GATYGO_RUN/last-select.env" RESULT)" \
			--arg code "$(_gatygo_env_get "$GATYGO_RUN/last-select.env" CODE)" \
			--arg time "$(_gatygo_env_get "$GATYGO_RUN/last-select.env" TIME)" \
			--arg message "$(_gatygo_env_get "$GATYGO_RUN/last-select.env" MESSAGE)" \
			'{result: $result, code: $code, time: $time, message: $message}') || _select=null
	fi
	_interval=$(gatygo_update_interval_hours)
	[ "$_running" = true ] && _next=$(gatygo_next_update "$_interval")
	_profiles='[]'
	[ -s "$GATYGO_STATE/subscription.json" ] && _profiles=$(gatygo_sub_profiles "$GATYGO_STATE/subscription.json")
	_upgrade=$(gatygo_upgrade_status_json)
	(
		[ -f "$GATYGO_STATE/headers.env" ] && . "$GATYGO_STATE/headers.env"
		[ -f "$GATYGO_STATE/last-update.env" ] && . "$GATYGO_STATE/last-update.env"
		# the profile of the installed config; installs from before this file existed only have
		# the one named by the last result
		_used=$(cat "$GATYGO_STATE/profile" 2>/dev/null) || _used=${PROFILE:-}
		[ -s "$GATYGO_STATE/xray.json" ] || _used=''
		jq -n --argjson running "$_running" --arg pid "$_pid" --arg crashed "$_crashed" --argjson crash "$_crash" --arg version "$GATYGO_VERSION" \
			--argjson configured "$_configured" --argjson enabled "$_enabled" --argjson send_hwid "$_send_hwid" \
			--argjson updating "$_updating" --arg uptime "$_uptime" --arg xray_version "$(gatygo_xray_version)" \
			--arg profile "$GATYGO_PROFILE" --arg used "$_used" --argjson profiles "$_profiles" \
			--arg title "${GATYGO_PROFILE_TITLE:-}" \
			--arg up "${GATYGO_USERINFO_UPLOAD:-}" --arg down "${GATYGO_USERINFO_DOWNLOAD:-}" \
			--arg total "${GATYGO_USERINFO_TOTAL:-}" --arg expire "${GATYGO_USERINFO_EXPIRE:-}" \
			--arg result "${RESULT:-}" --arg code "${CODE:-}" --arg time "${TIME:-}" --arg message "${MESSAGE:-}" \
			--argjson last_select "$_select" --arg interval "$_interval" --arg next "$_next" \
			--argjson upgrade "$_upgrade" \
			--arg maxdev "${GATYGO_HWID_MAX_DEVICES:-0}" --arg notsup "${GATYGO_HWID_NOT_SUPPORTED:-0}" \
			--arg geosite "$(date -r "$GATYGO_ASSETS/geosite.dat" +%s 2>/dev/null)" \
			--arg geoip "$(date -r "$GATYGO_ASSETS/geoip.dat" +%s 2>/dev/null)" \
			'{running: $running, pid: $pid, version: $version,
			  crashed: (if $crashed == "" then null else ($crashed | tonumber) end), crash: $crash,
			  configured: $configured, enabled: $enabled, send_hwid: $send_hwid, updating: $updating,
			  uptime: (if $uptime == "" then null else ($uptime | tonumber) end), xray_version: $xray_version,
			  profile: $profile, profile_used: $used,
			  profiles: $profiles, title: $title,
			  userinfo: {upload: $up, download: $down, total: $total, expire: $expire},
			  last_update: {result: $result, code: $code, time: $time, message: $message},
			  last_select: $last_select,
			  update_interval: ($interval | tonumber),
			  next_update: (if $next == "" then null else ($next | tonumber) end),
			  geo: {geosite_mtime: $geosite, geoip_mtime: $geoip},
			  hwid_flags: {max_devices: $maxdev, not_supported: $notsup},
			  upgrade: $upgrade}'
	)
}

case ${1:-} in
start | stop | restart) exec /etc/init.d/gatygo "$1" ;;
connect) cmd_connect "$2" ;;
forget) cmd_forget ;;
update) cmd_update ;;
select) cmd_select "$2" ;;
apply) cmd_apply "$2" ;;
check) cmd_check "$2" ;;
ping) cmd_ping "$2" ;;
route) cmd_route "$2" ;;
rules) cmd_rules ;;
status) cmd_status ;;
nodes)
	. "$GATYGO_LIB/nodes.sh"
	gatygo_load_config
	if [ -s "$GATYGO_STATE/xray.json" ]; then
		gatygo_nodes "$GATYGO_STATE/xray.json"
	else
		echo '{"api":false,"balancer":null,"nodes":[]}'
	fi
	;;
updating)
	. "$GATYGO_LIB/service.sh"
	gatygo_updating
	;;
log)
	. "$GATYGO_LIB/service.sh"
	gatygo_log_tail "${2:-200}"
	;;
watch)
	# procd notifies the subscribers of its ubus object; every line is one notification. The
	# subscriber is a child of this process and has to go with it when procd stops the instance,
	# hence the fifo instead of a pipeline: its pid is known.
	. "$GATYGO_LIB/crash.sh"
	_fifo=$GATYGO_RUN/watch.fifo
	mkdir -p "$GATYGO_RUN"
	rm -f "$_fifo"
	mkfifo "$_fifo" || exit 1
	ubus subscribe service > "$_fifo" 2>/dev/null &
	_sub=$!
	trap 'kill "$_sub" 2>/dev/null; rm -f "$_fifo"; exit 0' TERM INT
	while read -r _line; do
		gatygo_watch_line "$_line" && gatygo_on_crash
	done < "$_fifo"
	# the subscriber is gone (ubusd was restarted): procd starts the watcher again
	rm -f "$_fifo"
	exit 1
	;;
cron-sync)
	. "$GATYGO_LIB/service.sh"
	gatygo_load_config
	gatygo_cron_sync "$(gatygo_update_interval_hours)"
	;;
upgrade)
	# the page asks some of these every few seconds: no settings are read here (run's executor
	# reads them itself)
	. "$GATYGO_LIB/upgrade.sh"
	case ${2:-} in
	due) gatygo_upgrade_due ;;
	check) gatygo_upgrade_check ;;
	running) gatygo_locked upgrade ;;
	start)
		# one caller at a time: the look at the lock, the launch, the wait for the runner's lock
		gatygo_lock upgrade-start || {
			echo '{"started":false}'
			exit 0
		}
		if gatygo_locked upgrade; then
			gatygo_unlock upgrade-start
			echo '{"started":false}'
			exit 0
		fi
		(sh "$0" upgrade run </dev/null >/dev/null 2>&1 &)
		# the runner takes its lock a moment after it starts; one that fails at once is never
		# seen holding it: 3 s at most. Asked again at once: the install restarts rpcd, which
		# waits for this answer.
		_t=$(($(date +%s) + 3))
		until gatygo_locked upgrade || [ "$(date +%s)" -ge "$_t" ]; do :; done
		gatygo_unlock upgrade-start
		echo '{"started":true}'
		;;
	run)
		# the upgrade replaces this file and the library: it runs from a copy of the library's
		# files in /tmp (not of its directories: the 35 MB xray core lives in one)
		_ok=0 _tmp=${GATYGO_UPGRADE_TMP:-/tmp}
		if _d=$(mktemp -d "$_tmp/gatygo-upgrade.XXXXXX" 2>/dev/null) && mkdir "$_d/lib"; then
			_ok=1
			for _f in "$GATYGO_LIB"/*; do [ ! -f "$_f" ] || cp -p "$_f" "$_d/lib/" || _ok=0; done
		fi
		if [ "$_ok" = 0 ]; then
			# no room for the copy: the page says so, unless another upgrade owns the progress
			[ -n "${_d:-}" ] && rm -rf "$_d"
			gatygo_locked upgrade && exit 0
			gatygo_load_config
			gatygo_upgrade_begin "$GATYGO_VERSION" ""
			gatygo_upgrade_fail no_memory 1 $(($(_gatygo_upgrade_kb "$(gatygo_upgrade_free_kb "$_tmp")") / 1024))
			exit 1
		fi
		GATYGO_LIB="$_d/lib" exec sh -c '. "$GATYGO_LIB/upgrade.sh"; gatygo_load_config; gatygo_upgrade_run; _rc=$?; rm -rf "'"$_d"'"; exit $_rc'
		;;
	dismiss) gatygo_locked upgrade || rm -f "$GATYGO_RUN/upgrade.json" ;;
	*) usage ;;
	esac
	;;
version) cat "$GATYGO_LIB/version" ;;
*) usage ;;
esac
