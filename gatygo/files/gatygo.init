#!/bin/sh /etc/rc.common
# gatygo: xray (gatygo's own core, lib/core.sh) with a subscription profile + transparent proxy
# for the LAN.
# procd owns the xray process and a watcher that waits for procd to give up on it (lib/crash.sh);
# the side effects around it (nft table, dnsmasq settings,
# cron line) are applied once xray runs and removed on stop. `start` on a running service
# re-submits the instance: procd restarts xray only when xray.json, a geo file or the core changed,
# or an update or `gatygo relay-check` found a relay that moved (lib/relay.sh).
# `reload` (UCI trigger) additionally refreshes the subscription with the new settings; with
# updates only by hand only when the link or Send device ID changed. A VPN
# stopped by hand stays off: the settings are applied to the subscription only, and a package
# upgrade (which calls `start` as well) leaves it stopped.
START=95
STOP=10
USE_PROCD=1

GATYGO_LIB=/usr/lib/gatygo

_gatygo_env() {
	. "$GATYGO_LIB/config.sh"
	. "$GATYGO_LIB/firewall.sh"
	. "$GATYGO_LIB/dns.sh"
	. "$GATYGO_LIB/service.sh"
	. "$GATYGO_LIB/geo.sh"
	. "$GATYGO_LIB/crash.sh"
	. "$GATYGO_LIB/relay.sh"
	gatygo_load_config
}

start_service() {
	_gatygo_env
	[ "$GATYGO_ENABLED" = 1 ] || return 0
	# a package upgrade calls `start` too (default_postinst, with PKG_UPGRADE=1): a VPN stopped by
	# hand stays stopped. The Start button and a reboot (the flag lives in tmpfs) start it as always.
	[ "${PKG_UPGRADE:-}" = 1 ] && [ -f "$GATYGO_RUN/stopped" ] && return 0
	mkdir -p "$GATYGO_STATE" "$GATYGO_RUN" "$GATYGO_ASSETS"
	chmod 700 "$GATYGO_STATE"
	rm -f "$GATYGO_RUN/stopped"
	# the old core an upgrade kept for its rollback, left behind when the power went mid-way
	gatygo_locked upgrade || rm -rf "$GATYGO_CORE_DIR.prev"
	gatygo_crash_clear
	# the default geo files live in RAM (lib/geo.sh): after a reboot they come again in the
	# background, away from procd's lock, and the subscription is not asked. A config that names geo
	# data waits for them, the home network closed meanwhile with on_crash=block (the firewall rules
	# without xray let nothing through); one that names none starts at once, and the files follow
	# for the other profiles.
	if [ -s "$GATYGO_STATE/xray.json" ] && [ -x "$GATYGO_XRAY" ] && gatygo_geo_source_default \
		&& ! { [ -s "$GATYGO_ASSETS/geosite.dat" ] && [ -s "$GATYGO_ASSETS/geoip.dat" ]; }; then
		if gatygo_geo_missing "$GATYGO_STATE/xray.json"; then
			gatygo_dns_restore
			gatygo_log info "geo: downloading Loyalsoldier's geo files again (they are kept in RAM); the VPN starts once they are here"
			[ "$GATYGO_ON_CRASH" != block ] || gatygo_fw_apply
			gatygo_geo_restore_later start
			return 1
		fi
		gatygo_log info "geo: downloading Loyalsoldier's geo files again in the background (they are kept in RAM)"
		gatygo_geo_restore_later
	fi
	# an update brings it all: the xray core (once per gatygo release), the config, the geo files
	if [ ! -s "$GATYGO_STATE/xray.json" ] || [ ! -x "$GATYGO_XRAY" ] || gatygo_geo_missing "$GATYGO_STATE/xray.json"; then
		gatygo_log info "no cached config, xray core or geo files yet, downloading"
		gatygo_dns_restore
		/usr/bin/gatygo update || {
			gatygo_log error "cannot start without a config, a core and the geo files"
			return 1
		}
	fi
	procd_open_instance xray
	procd_set_param command "$GATYGO_XRAY" run -c "$GATYGO_STATE/xray.json"
	# the core's pin is a part of the instance: a replaced core means a restart; so does a new
	# reconnect value (a relay moved, lib/relay.sh)
	procd_set_param env XRAY_LOCATION_ASSET="$GATYGO_ASSETS" GATYGO_CORE="$(cut -c1-64 "$GATYGO_CORE_DIR/pin" 2>/dev/null)" \
		GATYGO_RECONNECT="$(cat "$GATYGO_RUN/reconnect" 2>/dev/null)"
	procd_set_param file "$GATYGO_STATE/xray.json" "$GATYGO_ASSETS/geosite.dat" "$GATYGO_ASSETS/geoip.dat"
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65535 65535"
	# xray logs to its console: procd relays both streams to the system log (tag xray)
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	# never given up on: it only waits
	procd_open_instance watch
	procd_set_param command /usr/bin/gatygo watch
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_started() {
	_gatygo_env
	[ "$GATYGO_ENABLED" = 1 ] || return 0
	# start_service left a VPN stopped by hand as it was (a package upgrade): nothing to put around it
	[ -f "$GATYGO_RUN/stopped" ] && return 0
	# no xray yet: it waits for the default geo files, and their download starts the service
	gatygo_geo_waiting && return 0
	# procd spawns the instance asynchronously: give it up to 10 s to show up as running
	# (whole seconds: OpenWrt's busybox sleep rejects 0.5)
	_gatygo_i=0
	while ! gatygo_xray_running; do
		_gatygo_i=$((_gatygo_i + 1))
		[ "$_gatygo_i" -lt 10 ] || return 0
		sleep 1
	done
	gatygo_fw_apply
	gatygo_dns_apply "$GATYGO_STATE/xray.json"
	# the addresses xray is about to connect to: an update compares with them (lib/relay.sh). New
	# settings restart dnsmasq, and the init script returns before it answers: up to 5 s for that.
	_gatygo_i=0
	until nslookup localhost >/dev/null 2>&1 || [ "$_gatygo_i" -ge 5 ]; do
		_gatygo_i=$((_gatygo_i + 1))
		sleep 1
	done
	gatygo_relay_note "$GATYGO_STATE/xray.json"
	gatygo_cron_sync "$(gatygo_update_schedule)"
	# One background refresh per boot: the tunnel is already up on the cached config. None when
	# updates are only by hand, and the boot counts as done all the same: switching back later must
	# not bring it (Save & Apply downloads then anyway).
	if [ ! -f "$GATYGO_RUN/boot-update-done" ]; then
		touch "$GATYGO_RUN/boot-update-done"
		if gatygo_auto_update; then
			# away from procd's lock (rc.common holds it on fd 1000): kept, a Stop would wait for it
			(
				sleep 30
				/usr/bin/gatygo update
			) 1000>&- >/dev/null 2>&1 &
		fi
	fi
}

stop_service() {
	_gatygo_env
	gatygo_dns_restore
	gatygo_fw_remove
	gatygo_cron_remove
	gatygo_crash_clear
	# the VPN no longer waits for the default geo files: their download ends by itself
	rm -f "$GATYGO_RUN/geo-wait"
	# stopped by hand, as opposed to switched off in the settings: reload_service keeps it off
	# (tmpfs: a reboot starts an enabled service as usual)
	mkdir -p "$GATYGO_RUN"
	if [ "$GATYGO_ENABLED" = 1 ]; then touch "$GATYGO_RUN/stopped"; else rm -f "$GATYGO_RUN/stopped"; fi
}

# procd forgets a stopped service and its config trigger with it. Register the service again
# with the trigger alone, so that Save & Apply still reaches reload_service.
service_stopped() {
	procd_open_service gatygo "$initscript"
	procd_close_service
}

# reload = the UCI config changed (Save & Apply). The cached subscription is rebuilt with the new
# settings and the user's rules first (`gatygo apply`): they take effect even when the panel does
# not answer. A download follows (`gatygo update settings`): always with automatic updates, and
# with updates only by hand when the link or Send device ID changed since the last one. The
# instance itself is re-submitted by `start`, which restarts xray only when its files changed.
# The daemon's own post-update path calls `start` directly, not `reload`.
reload_service() {
	_gatygo_env
	if [ "$GATYGO_ENABLED" != 1 ]; then
		stop
		return 0
	fi
	if [ -f "$GATYGO_RUN/stopped" ]; then
		(/usr/bin/gatygo apply wait; /usr/bin/gatygo update settings) >/dev/null 2>&1 &
		return 0
	fi
	_gatygo_was_running=0
	gatygo_xray_running && _gatygo_was_running=1
	/usr/bin/gatygo apply >/dev/null 2>&1
	_gatygo_applied=$?
	start
	if [ "$_gatygo_was_running" = 1 ]; then
		gatygo_cron_sync "$(gatygo_update_schedule)"
		# an update held the lock and read the old settings: apply once it is over
		( [ "$_gatygo_applied" != 2 ] || /usr/bin/gatygo apply wait; /usr/bin/gatygo update settings ) >/dev/null 2>&1 &
	fi
}

service_triggers() {
	procd_add_reload_trigger "gatygo"
}
