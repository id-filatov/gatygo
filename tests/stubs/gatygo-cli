#!/bin/sh
# gatygo CLI stand-in for the rpcd plugin and upgrade tests: canned answers; records every call.
echo "$*" >> "${GATYGO_CLI_LOG:?}"
case $1 in
    status) echo '{"running":true,"profile_used":"🌐 Auto","last_update":{"result":"error","code":"fetch_failed","message":"subscription download failed","time":"1"},"last_select":{"result":"ok","code":"applied","message":"profile applied","time":"2"}}' ;;
    log) _i=0; while [ "$_i" -lt "${2:-200}" ]; do _i=$((_i + 1)); echo "line $_i"; done ;;
    updating) exit "${GATYGO_CLI_UPDATING_RC:-1}" ;;
    update) sleep 1; touch "${GATYGO_CLI_UPDATE_MARK:?}" ;;
    select) exit "${GATYGO_CLI_SELECT_RC:-0}" ;;
    check) echo '{"available":true,"tunnel":"🌐 Auto:4242","time":1,"services":[{"name":"Alpha","ms":12}]}' ;;
    ping)
        if [ "$2" = kept ]; then
            echo '{"time":1,"measuring":false,"profiles":[{"remarks":"🌐 Auto","ms":12}]}'
            exit "${GATYGO_CLI_PING_KEPT_RC:-0}"
        fi
        sleep 1; touch "${GATYGO_CLI_UPDATE_MARK:?}.ping"
        ;;
    connect) sleep 1; touch "${GATYGO_CLI_UPDATE_MARK:?}.connect" ;;
    forget)
        [ "${GATYGO_CLI_FORGET_RC:-0}" = 1 ] && echo "the VPN could not be stopped" >&2
        exit "${GATYGO_CLI_FORGET_RC:-0}"
        ;;
    rules) echo '{"available":true,"api":true,"pending":false,"profile":"🌐 Auto","rules":[{"domain":"rare.example","to":"direct","status":"works"}]}' ;;
    route) echo '{"available":true,"to":"direct"}' ;;
    upgrade)
        case $2 in
            due) exit "${GATYGO_CLI_UPGRADE_DUE_RC:-1}" ;;
            check) sleep 1; touch "${GATYGO_CLI_UPDATE_MARK:?}.check" ;;
            # running: as told, or while a run below is under way
            running) [ -n "${GATYGO_CLI_UPGRADE_RUNNING_RC:-}" ] && exit "$GATYGO_CLI_UPGRADE_RUNNING_RC"; test -e "${GATYGO_CLI_UPDATE_MARK:?}.running" ;;
            # the executor takes its lock a moment after it starts (it copies the library first)
            run) sleep 1; touch "${GATYGO_CLI_UPDATE_MARK:?}.running"; sleep 2; touch "$GATYGO_CLI_UPDATE_MARK.upgrade"; rm -f "$GATYGO_CLI_UPDATE_MARK.running" ;;
            dismiss) ;;
            *) exit 1 ;;
        esac
        ;;
    # the upgrade's rebuild of the config and its look at the installed version
    apply)
        [ "${GATYGO_CLI_APPLY_RC:-0}" = 0 ] && echo '{"v":"new"}' > "$GATYGO_STATE/xray.json"
        exit "${GATYGO_CLI_APPLY_RC:-0}"
        ;;
    version) if [ -n "$GATYGO_CLI_VERSION" ]; then echo "$GATYGO_CLI_VERSION"; else cat "$GATYGO_LIB/version"; fi ;;
    *) exit 1 ;;
esac
